 @Composable
+private fun GitHubChatWorkflowCard(
+    workflow: GitHubChatWorkflow,
+    work: GitHubWorkSnapshot,
+    running: Boolean,
+    checksPassed: Boolean,
+    checkOutput: String,
+    onRunChecks: (String) -> Unit,
+    onPublish: (String, String) -> Unit,
+) {
+    var confirmPublish by rememberSaveable { mutableStateOf(false) }
+    if (confirmPublish) {
+        AlertDialog(
+            onDismissRequest = { confirmPublish = false },
+            icon = { Icon(Icons.Default.Shield, null) },
+            title = { Text("Publish this pull request?") },
+            text = {
+                Column(verticalArrangement = Arrangement.spacedBy(7.dp)) {
+                    Text("Branch: ${work.branch}", fontFamily = FontFamily.Monospace, fontSize = 12.sp)
+                    Text("Base: ${work.baseBranch}", fontFamily = FontFamily.Monospace, fontSize = 12.sp)
+                    Text("Checks passed. This will commit, push, and open the PR; main/master remain protected.")
+                }
+            },
+            confirmButton = {
+                Button(onClick = {
+                    confirmPublish = false
+                    onPublish(workflow.commitMessage, workflow.pullRequestTitle)
+                }) { Text("Confirm and open PR") }
+            },
+            dismissButton = { TextButton(onClick = { confirmPublish = false }) { Text("Cancel") } },
+        )
+    }
+    Surface(
+        shape = RoundedCornerShape(16.dp),
+        color = MaterialTheme.colorScheme.primary.copy(alpha = 0.07f),
+        border = BorderStroke(1.dp, MaterialTheme.colorScheme.primary.copy(alpha = 0.28f)),
+        modifier = Modifier.fillMaxWidth(),
+    ) {
+        Column(Modifier.padding(14.dp), verticalArrangement = Arrangement.spacedBy(9.dp)) {
+            Row(verticalAlignment = Alignment.CenterVertically) {
+                Icon(Icons.Default.Code, null, tint = MaterialTheme.colorScheme.primary)
+                Spacer(Modifier.width(8.dp))
+                Column(Modifier.weight(1f)) {
+                    Text("GitHub PR workflow", fontWeight = FontWeight.Bold)
+                    Text(workflow.stage.label, fontSize = 11.sp, color = MaterialTheme.colorScheme.primary)
+                }
+                if (running) CircularProgressIndicator(Modifier.size(20.dp), strokeWidth = 2.dp)
+            }
+            Text(workflow.message, color = MaterialTheme.colorScheme.onSurfaceVariant, fontSize = 12.sp)
+            if (work.branch.isNotBlank()) {
+                Text("${work.branch} → ${work.baseBranch}", fontFamily = FontFamily.Monospace, fontSize = 11.sp)
+            }
+            if (work.status.isNotBlank()) {
+                SelectionContainer { Text(work.status, fontFamily = FontFamily.Monospace, fontSize = 10.sp, maxLines = 6, overflow = TextOverflow.Ellipsis) }
+            }
+            if (checkOutput.isNotBlank()) {
+                SelectionContainer { Text(checkOutput.takeLast(1_500), fontFamily = FontFamily.Monospace, fontSize = 10.sp, color = if (checksPassed) PocketGreen else MaterialTheme.colorScheme.error) }
+            }
+            when {
+                workflow.stage == GitHubChatStage.COMPLETE && !workflow.pullRequestUrl.isNullOrBlank() -> {
+                    SelectionContainer { Text(workflow.pullRequestUrl, color = PocketGreen, fontWeight = FontWeight.SemiBold) }
+                }
+                workflow.stage in setOf(GitHubChatStage.REVIEW, GitHubChatStage.ERROR) && !running -> {
+                    Button(onClick = { onRunChecks(workflow.checkCommand) }, modifier = Modifier.fillMaxWidth()) {
+                        Text("Run checks in chat")
+                    }
+                }
+                workflow.stage == GitHubChatStage.READY_TO_PUBLISH && checksPassed && !running -> {
+                    Button(onClick = { confirmPublish = true }, modifier = Modifier.fillMaxWidth()) {
+                        Text("Review confirmation and open PR")
+                    }
+                }
+            }
+        }
+    }
+}
